# ===============================================
# BACKUP STORAGE CONFIGURATION
# ===============================================

# Backup destination: 'local', 'aws', or 'r2'
# Default: 'aws'
BACKUP_DESTINATION_TYPE="r2"

# Local backup path (required only if BACKUP_DESTINATION_TYPE=local)
LOCAL_BACKUP_PATH="/path/to/backup/folder"

# Cloudflare R2 Configuration (if BACKUP_DESTINATION_TYPE=r2)
R2_ACCOUNT_ID="TODO"
R2_ACCESS_KEY_ID="TODO"
R2_SECRET_ACCESS_KEY="TODO"
R2_BUCKET="TODO"

# AWS S3 Configuration (if BACKUP_DESTINATION_TYPE=aws)
AWS_ACCESS_KEY_ID="TODO"
AWS_SECRET_ACCESS_KEY="TODO"
AWS_S3_BUCKET="TODO"
AWS_S3_REGION="us-east-1"

# ===============================================
# DATABASE CONFIGURATION
# ===============================================

# New Format (Recommended): Multiple databases (PostgreSQL and/or MSSQL)
DATABASE_CONFIGS='[
  {
    "type": "postgresql",
    "name": "my_postgres_db",
    "connectionString": "postgresql://user:password@localhost:5432/dbname"
  },
  {
    "type": "mssql",
    "name": "my_mssql_db",
    "host": "localhost",
    "port": 1433,
    "database": "dbname",
    "user": "sa",
    "password": "YourPassword123",
    "options": {
      "encrypt": true,
      "trustServerCertificate": true
    }
  }
]'

# Legacy Format (Still Supported): Single PostgreSQL database
BACKUP_DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Path to PostgreSQL tools (required for PostgreSQL backups) (Include trailing slash)
PG_DUMP_PATH="/usr/bin/"

# ===============================================
# FILES BACKUP CONFIGURATION
# ===============================================

# Required source: 'local', 'listingUrl', 'zippedFile', or 'supabase'
FILES_BACKUP_SOURCE="local"

# Used when FILES_BACKUP_SOURCE=local
FILES_BACKUP_PATH="/path/to/files/"

# Used when FILES_BACKUP_SOURCE=zippedFile
FILES_BACKUP_URL="https://example.com/files-backup.zip"

# Used when FILES_BACKUP_SOURCE=listingUrl
FILES_BACKUP_LISTING_URL="https://example.com/uploads/list-all-files?password=123456"

# Used when FILES_BACKUP_SOURCE=supabase
SUPABASE_URL="https://project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="TODO"
SUPABASE_BUCKET="TODO"
FILES_BACKUP_SUPABASE_PREFIX="uploads" # Optional path inside SUPABASE_BUCKET to use as the source

# ===============================================
# SCHEDULE CONFIGURATION
# ===============================================

# Run backup immediately when the application starts
RUN_ON_STARTUP="true"

# Cron expression for scheduled backups
# Examples:
# - Every minute: * * * * *
# - Every hour: 0 * * * *
# - Every day at 2 AM: 0 2 * * *
# - Every Sunday at 3 AM: 0 3 * * 0
CRON_JOB_INTERVAL="0 2 * * *"